# WordPress REST base, e.g. https://example.com/wp-json/tvam/v1
TVAM_API_BASE_URL=https://your-site.com/wp-json/tvam/v1

# API key from TradingView Manager → Settings
TVAM_API_KEY=replace-with-plugin-api-key

# Polling interval in milliseconds
TVAM_POLL_INTERVAL_MS=5000

# Max jobs claimed per poll
TVAM_JOB_LIMIT=3

# Path to Playwright storage state (persistent login)
TVAM_STORAGE_STATE=./storage/storageState.json

# Headless browser (true/false). Use false while debugging selectors.
TVAM_HEADLESS=true

# Delay between script operations (ms)
TVAM_ACTION_DELAY_MS=1500

# Max retries inside the worker before reporting failure without retry flag
TVAM_WORKER_RETRIES=2
